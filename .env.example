# Kopieren nach `.env` und anpassen. Alle Variablen haben das Präfix ARR_.

# ---------------------------------------------------------------------------
# Modus 1: komplett lokal (Standard) – nichts weiter nötig außer Ollama
# ---------------------------------------------------------------------------
ARR_LLM_PROVIDER=ollama
ARR_EMBEDDING_PROVIDER=ollama
ARR_VECTOR_STORE=local
ARR_DOCUMENT_SOURCE=local
ARR_OLLAMA_BASE_URL=http://localhost:11434/v1
ARR_OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct-q4_k_m
ARR_OLLAMA_EMBEDDING_MODEL=bge-m3

# ---------------------------------------------------------------------------
# Modus 2: komplett Azure  (Werte gibt infra/deploy.sh aus)
# ---------------------------------------------------------------------------
# ARR_LLM_PROVIDER=azure_openai
# ARR_EMBEDDING_PROVIDER=azure_openai
# ARR_VECTOR_STORE=azure_search
# ARR_DOCUMENT_SOURCE=azure_blob
# ARR_AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/
# ARR_AZURE_OPENAI_API_KEY=            # leer lassen => Entra ID / az login
# ARR_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# ARR_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# ARR_AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
# ARR_AZURE_SEARCH_API_KEY=            # leer lassen => Entra ID
# ARR_AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net/

# ---------------------------------------------------------------------------
# Modus 3: Hybrid – Daten & Index in Azure, Inferenz lokal (Datenschutz!)
# ---------------------------------------------------------------------------
# ARR_LLM_PROVIDER=ollama
# ARR_EMBEDDING_PROVIDER=ollama
# ARR_VECTOR_STORE=azure_search
# ARR_DOCUMENT_SOURCE=azure_blob
# ARR_EMBEDDING_DIMENSIONS=1024
